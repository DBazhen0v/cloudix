SECRET_KEY=change-me-to-a-random-value
ADMIN_PASSWORD_HASH=generate-with-python-generate_admin_hash.py
# Local dev: matches docker-compose.yml (run `docker compose up -d` first).
# Production: Render injects this automatically once a Postgres instance is
# linked to the service - no manual value needed there.
DATABASE_URL=postgresql://cloudex:cloudex@localhost:5432/cloudex
# Optional: set once you have a real wallet address to accept crypto payments
CRYPTO_WALLET_ADDRESS=
# Optional: real support contacts. Left empty, the site hides that contact
# method instead of showing a placeholder.
SUPPORT_TELEGRAM_URL=
SUPPORT_EMAIL=
# Optional: enables "Sign in with Google". Left empty, the Google button
# stays disabled ("скоро") instead of a broken link. See README for the
# Google Cloud Console setup steps.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
